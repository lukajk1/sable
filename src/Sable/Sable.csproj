<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- A window, not a console app: no console opens beside it. Program attaches to the parent terminal for the
         options that print (check, bench, selftest). -->
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>Sable</RootNamespace>
    <AssemblyName>Sable</AssemblyName>
    <ApplicationIcon>..\..\assets\icon\sable.ico</ApplicationIcon>
    <!-- The installer (installer/build.py) takes its version from here. -->
    <Version>0.4.0</Version>
    <Product>Sable</Product>
    <Description>Paint textures on 3D models</Description>
  </PropertyGroup>

  <ItemGroup>
    <!-- The window icon (raylib wants an image, not the .ico). -->
    <EmbeddedResource Include="..\..\assets\icon\sable-64.png" LogicalName="Sable.icon.png" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="AssimpNet" Version="5.0.0-beta1" />
    <PackageReference Include="ImGui.NET" Version="1.91.6.1" />
    <!-- rlImgui-cs 3.2.0 is built against Raylib-cs 7.0.1; keep them in step. -->
    <PackageReference Include="Raylib-cs" Version="7.0.1" />
    <PackageReference Include="rlImgui-cs" Version="3.2.0" />
  </ItemGroup>

</Project>
